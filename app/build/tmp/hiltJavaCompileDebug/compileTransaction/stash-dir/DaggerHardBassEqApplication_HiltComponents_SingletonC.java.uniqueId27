    private static final class SwitchingProvider<T> implements Provider<T> {
      private final SingletonCImpl singletonCImpl;

      private final int id;

      SwitchingProvider(SingletonCImpl singletonCImpl, int id) {
        this.singletonCImpl = singletonCImpl;
        this.id = id;
      }

      @Override
      @SuppressWarnings("unchecked")
      public T get() {
        switch (id) {
          case 0: // com.hardbasseq.eq.auto.AppAutoCatalog
          return (T) new AppAutoCatalog(singletonCImpl.dataStorePlaylistRepositoryProvider.get(), singletonCImpl.dataStoreDiscoveryRepositoryProvider.get(), singletonCImpl.androidPlayerControllerProvider.get(), singletonCImpl.androidTextProvider.get());

          case 1: // com.hardbasseq.eq.playlist.DataStorePlaylistRepository
          return (T) new DataStorePlaylistRepository(ApplicationContextModule_ProvideContextFactory.provideContext(singletonCImpl.applicationContextModule));

          case 2: // com.hardbasseq.eq.discovery.DataStoreDiscoveryRepository
          return (T) new DataStoreDiscoveryRepository(ApplicationContextModule_ProvideContextFactory.provideContext(singletonCImpl.applicationContextModule));

          case 3: // com.hardbasseq.eq.integration.AndroidPlayerController
          return (T) new AndroidPlayerController(ApplicationContextModule_ProvideContextFactory.provideContext(singletonCImpl.applicationContextModule));

          case 4: // com.hardbasseq.eq.text.AndroidTextProvider
          return (T) new AndroidTextProvider(ApplicationContextModule_ProvideContextFactory.provideContext(singletonCImpl.applicationContextModule));

          case 5: // com.hardbasseq.eq.discovery.DiscoveryUpdater
          return (T) new DiscoveryUpdater(singletonCImpl.dataStoreDiscoveryRepositoryProvider.get(), singletonCImpl.bindDiscoverySourceProvider.get());

          case 6: // com.hardbasseq.eq.discovery.AndroidDiscoverySource
          return (T) new AndroidDiscoverySource(ApplicationContextModule_ProvideContextFactory.provideContext(singletonCImpl.applicationContextModule));

          case 7: // com.hardbasseq.eq.audio.AndroidAudioEffectRepository
          return (T) new AndroidAudioEffectRepository();

          case 8: // com.hardbasseq.eq.audio.AndroidAudioEngine
          return (T) new AndroidAudioEngine(DispatcherModule_ProvideDefaultDispatcherFactory.provideDefaultDispatcher(), singletonCImpl.bindAudioEffectRepositoryProvider.get());

          case 9: // com.hardbasseq.eq.audio.AndroidAudioRouteRepository
          return (T) new AndroidAudioRouteRepository(ApplicationContextModule_ProvideContextFactory.provideContext(singletonCImpl.applicationContextModule));

          case 10: // com.hardbasseq.eq.audio.AndroidSystemVolumeRepository
          return (T) new AndroidSystemVolumeRepository(ApplicationContextModule_ProvideContextFactory.provideContext(singletonCImpl.applicationContextModule));

          case 11: // com.hardbasseq.eq.diagnostics.InMemoryDiagnosticsRecorder
          return (T) new InMemoryDiagnosticsRecorder();

          case 12: // com.hardbasseq.eq.integration.AndroidPlayerBridge
          return (T) new AndroidPlayerBridge(ApplicationContextModule_ProvideContextFactory.provideContext(singletonCImpl.applicationContextModule));

          case 13: // com.hardbasseq.eq.preset.RoomPresetRepository
          return (T) new RoomPresetRepository(singletonCImpl.presetDao());

          case 14: // com.hardbasseq.eq.data.db.AppDatabase
          return (T) DatabaseModule_ProvideAppDatabaseFactory.provideAppDatabase(ApplicationContextModule_ProvideContextFactory.provideContext(singletonCImpl.applicationContextModule));

          case 15: // com.hardbasseq.eq.settings.DataStoreAppSettingsRepository
          return (T) new DataStoreAppSettingsRepository(ApplicationContextModule_ProvideContextFactory.provideContext(singletonCImpl.applicationContextModule));

          case 16: // com.hardbasseq.eq.correction.RoomCorrectionProfileRepository
          return (T) new RoomCorrectionProfileRepository(singletonCImpl.correctionProfileDao());

          case 17: // com.hardbasseq.eq.profile.RoomDeviceProfileRepository
          return (T) new RoomDeviceProfileRepository(singletonCImpl.deviceProfileDao());

          case 18: // com.hardbasseq.eq.profile.SharedPreferencesDeviceAliasStore
          return (T) new SharedPreferencesDeviceAliasStore(ApplicationContextModule_ProvideContextFactory.provideContext(singletonCImpl.applicationContextModule));

          case 19: // com.hardbasseq.eq.audio.AndroidAudioSessionRepository
