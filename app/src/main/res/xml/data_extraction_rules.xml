<?xml version="1.0" encoding="utf-8"?>
<!--
  Same rule for Android 12 and newer, for cloud backup and for the transfer to a new device.
  See backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sc_auth_prefs.xml" />
        <exclude domain="sharedpref" path="spotify_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sc_auth_prefs.xml" />
        <exclude domain="sharedpref" path="spotify_auth.xml" />
    </device-transfer>
</data-extraction-rules>
