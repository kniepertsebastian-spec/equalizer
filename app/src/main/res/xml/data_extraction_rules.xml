<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and newer. Presets, playlists and settings go to a new phone, by cloud backup and by
  cable/wireless transfer. The SoundCloud and Spotify sign-in (sc_auth_prefs.xml, spotify_auth.xml)
  stays behind (AuraCurve roadmap 03, 2.2): the tokens are encrypted with a Keystore key that never
  leaves the phone (2.1), so after a restore the user signs in again. This replaces the earlier
  choice to let the sign-in travel along (open_questions.md Q16).

  The cloud backup is still skipped on a phone that cannot encrypt it (no lock screen set).
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="sc_auth_prefs.xml" />
        <exclude domain="sharedpref" path="spotify_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sc_auth_prefs.xml" />
        <exclude domain="sharedpref" path="spotify_auth.xml" />
    </device-transfer>
</data-extraction-rules>
