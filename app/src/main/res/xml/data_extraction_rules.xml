<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and newer. Presets, playlists, settings and the SoundCloud and Spotify sign-in
  (sc_auth_prefs.xml, spotify_auth.xml) go to a new phone, by cloud backup and by cable/wireless
  transfer, so nobody has to sign in again after a restore (open_questions.md Q16).

  The sign-in tokens are only as safe as the backup, so the cloud backup is skipped on a phone
  that cannot encrypt it with the lock screen (no lock screen set).
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true" />
    <device-transfer />
</data-extraction-rules>
