<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".HardBassEqApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HardBassEQ">

        <!--
          singleTask: a link shared into the app from another app must reach the
          already-running instance (onNewIntent) rather than start a second
          MainActivity with its own view models next to the first.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.HardBassEQ">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share target for text, used for SoundCloud links. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          foregroundServiceType="mediaPlayback": this service doesn't play media itself,
          but there is no FGS type that exactly fits "listen for other apps' audio
          sessions to attach effects" - mediaPlayback is what comparable published
          system-wide equalizer apps use for this, and keeps this out of the
          Play-policy-reviewed "specialUse" category. See roadmap.md Session 13.
        -->
        <service
            android:name=".service.AudioSessionForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
          Android Auto: the media browser the car shows (playlists, new uploads, likes) and
          the declaration that this app is a media app. See AutoBrowserService.
        -->
        <service
            android:name=".auto.AutoBrowserService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
    </application>

</manifest>
