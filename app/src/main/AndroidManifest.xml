<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Normal permission, granted automatically at install (no runtime prompt). Required for
      AudioPlaybackConfiguration.getAudioSessionId() in AudioSessionRepository's
      AudioManager.AudioPlaybackCallback fallback path - without it that call returns
      AUDIO_SESSION_ID_GENERATE (0) for other apps' sessions instead of the real id. See
      AudioSessionRepository.kt for why this fallback exists alongside the broadcast receiver.
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:name=".HardBassEqApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HardBassEQ">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.HardBassEQ">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          foregroundServiceType="mediaPlayback": this service doesn't play media itself,
          but there is no FGS type that exactly fits "listen for other apps' audio
          sessions to attach effects" - mediaPlayback is what comparable published
          system-wide equalizer apps use for this, and keeps this out of the
          Play-policy-reviewed "specialUse" category. See roadmap.md Session 13.
        -->
        <service
            android:name=".service.AudioSessionForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
