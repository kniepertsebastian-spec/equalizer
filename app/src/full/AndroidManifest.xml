<?xml version="1.0" encoding="utf-8"?>
<!--
  Flavor "full" only (AuraCurve roadmap 02, 1.3): the self-update (install permission and the
  file provider the downloaded APK is handed over with) and the share target for links. The
  store flavor gets updates from Google Play and imports no links.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- Share target for text, used for SoundCloud, YouTube and Spotify links. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
    </application>

</manifest>
