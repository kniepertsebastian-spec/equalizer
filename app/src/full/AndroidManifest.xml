<?xml version="1.0" encoding="utf-8"?>
<!--
  Flavor "full" only (AuraCurve roadmap 02, 1.3): the self-update (install permission and the
  file provider the downloaded APK is handed over with) and the share target for links. The
  store flavor gets updates from Google Play and imports no links.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Local remote-control server (Pixel-Car module 04a). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application>
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- Share target for text, used for SoundCloud, YouTube and Spotify links. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          Local remote-control server (Pixel-Car module 04a). specialUse: it neither plays media
          nor syncs data, and unlike mediaPlayback/dataSync it may still be started from
          BOOT_COMPLETED on Android 15 (module 04e). Sideloaded only, never on Google Play.
        -->
        <service
            android:name=".remote.RemoteServerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local HTTP server for a web remote in the same private network (car hotspot): controls the equalizer and playback." />
        </service>

        <!--
          Pixel-Car module 04c (U-1): lets the user grant notification access, which the remote
          server needs to read and steer Spotify's MediaSession. It reads no notifications.
        -->
        <service
            android:name=".remote.playback.RemoteNotificationListener"
            android:exported="true"
            android:label="@string/remote_notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
    </application>

</manifest>
