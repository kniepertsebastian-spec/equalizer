<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application>

        <!--
          Not a launcher entry point - HardBass EQ's own MainActivity starts this
          explicitly (via PlayerBridge) once the user picks a source after switching
          the master bar on. Same-app now, so exported=false; the manifest merger
          folds this into HardBassEQ's single application, no separate app icon.
        -->
        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:theme="@style/Theme.SoundCloudEqualizerPlayer" />

        <activity
            android:name=".auth.SoundCloudLoginActivity"
            android:exported="false"
            android:label="SoundCloud Login" />

        <service
            android:name=".service.AudioPlayerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
