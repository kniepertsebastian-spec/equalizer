<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- ExoPlayer setWakeMode: keep CPU and Wi-Fi awake while music streams with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>

        <!--
          The built-in player: one media library session for the notification, the lock screen,
          Bluetooth, Wear and Android Auto, which also browses the app's playlists through it.
          Exported for the system and the car; AudioPlayerService only lets the system, Android
          Auto and the assistant browse. The app's manifest adds the Android Auto entries
          (browser and voice search) next to its automotive declaration.
        -->
        <service
            android:name=".service.AudioPlayerService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
            </intent-filter>
        </service>
    </application>

</manifest>
