<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- ExoPlayer setWakeMode: keep CPU and Wi-Fi awake while music streams with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>

        <!--
          Needs an explicit AppCompat-descended theme:
          with none set here it fell back to the merged app's own application theme
          (Theme.HardBassEQ, parent android:Theme.Material.Light.NoActionBar - not an
          AppCompat/Material Components theme). AppCompatActivity.setContentView()
          throws IllegalStateException("You need to use a Theme.AppCompat theme (or
          descendant) with this activity.") in that case, which crashed this activity
          immediately on every launch, before the WebView was ever created - looked
          from the outside like tapping Login did nothing and bounced straight back.
        -->
        <activity
            android:name=".auth.SoundCloudLoginActivity"
            android:exported="false"
            android:label="SoundCloud Login"
            android:theme="@style/Theme.SoundCloudEqualizerPlayer" />

        <!--
          Spotify sign-in: the browser is sent back to hardbasseq://spotify-callback (the redirect
          address registered in the user's Spotify developer app). Exported because the browser
          starts it; the sign-in state it checks keeps other apps from feeding it a code.
        -->
        <activity
            android:name=".spotify.SpotifyLoginActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="hardbasseq"
                    android:host="spotify-callback" />
            </intent-filter>
        </activity>

        <!--
          The built-in player: one media library session for the notification, the lock screen,
          Bluetooth, Wear and Android Auto, which also browses the app's playlists through it.
          Exported for the system and the car; AudioPlayerService only lets the system, Android
          Auto and the assistant browse. The app's manifest adds the Android Auto entries
          (browser and voice search) next to its automotive declaration.
        -->
        <service
            android:name=".service.AudioPlayerService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
            </intent-filter>
        </service>
    </application>

</manifest>
